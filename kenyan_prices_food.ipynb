    "# Build a structured data dictionary for the markets dataset only\n",
    "market_descriptions = {\n",
    "    \"market_id\": \"Unique identifier for each market\",\n",
    "    \"market\": \"Name of the market\",\n",
    "    \"countryiso3\": \"Three-letter country code\",\n",
    "    \"admin1\": \"First-level administrative region\",\n",
    "    \"admin2\": \"Second-level administrative region\",\n",
    "    \"latitude\": \"Geographic latitude of the market\",\n",
    "    \"longitude\": \"Geographic longitude of the market\"\n",
    "}\n",
    "\n",
    "data_dictionary_markets = pd.DataFrame({\n",
    "    \"column\": markets_raw.columns,\n",
    "    \"dtype\": [str(markets_raw[column].dtype) for column in markets_raw.columns],\n",
    "    \"n_unique\": [markets_raw[column].nunique() for column in markets_raw.columns],\n",
    "    \"n_missing\": [markets_raw[column].isna().sum() for column in markets_raw.columns],\n",
    "    \"pct_missing\": [\n",
    "        (markets_raw[column].isna().mean() * 100).round(2)\n",
    "        for column in markets_raw.columns\n",
    "    ],\n",
    "    \"description\": [\n",
    "        market_descriptions.get(column, \"Description not specified\")\n",
    "        for column in markets_raw.columns\n",
    "    ]\n",
    "})\n",
    "\n",
    "data_dictionary_markets"
   ]
