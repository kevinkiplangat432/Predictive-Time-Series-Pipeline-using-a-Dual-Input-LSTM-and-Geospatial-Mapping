    "# Step 1: Clean column names\n",
    "markets.columns = markets.columns.str.strip()\n",
    "\n",
    "# Step 2: Clean text values\n",
    "text_columns = [\"market\", \"countryiso3\", \"admin1\", \"admin2\"]\n",
