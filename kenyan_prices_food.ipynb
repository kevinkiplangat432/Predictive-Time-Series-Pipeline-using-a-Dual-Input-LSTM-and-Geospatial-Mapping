   "source": [
    "# Combine the cleaned price and market datasets\n",
    "# market_id is the stable identifier shared by both datasets\n",
    "prices[\"market_id\"] = pd.to_numeric(\n",
    "    prices[\"market_id\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "markets[\"market_id\"] = pd.to_numeric(\n",
    "    markets[\"market_id\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "# Select the canonical market information for the final dataset\n",
    "market_lookup = markets[\n",
    "    [\n",
    "        \"market_id\",\n",
    "        \"market\",\n",
    "        \"countryiso3\",\n",
    "        \"admin1\",\n",
    "        \"admin2\",\n",
    "        \"latitude\",\n",
    "        \"longitude\"\n",
    "    ]\n",
    "].drop_duplicates(subset=[\"market_id\"])\n",
    "\n",
    "# Remove duplicate market fields from prices before the merge\n",
    "market_columns = [\n",
    "    \"market\",\n",
    "    \"countryiso3\",\n",
    "    \"admin1\",\n",
    "    \"admin2\",\n",
    "    \"latitude\",\n",
    "    \"longitude\"\n",
    "]\n",
    "price_observations = prices.drop(\n",
    "    columns=[\n",
    "        column\n",
    "        for column in market_columns\n",
    "        if column in prices.columns\n",
    "    ]\n",
    ")\n",
    "\n",
    "# Add market details to each food-price observation\n",
    "prices_markets = price_observations.merge(\n",
    "    market_lookup,\n",
    "    on=\"market_id\",\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\",\n",
    "    indicator=True\n",
    ")\n",
    "\n",
    "# Count price records that did not match a market record\n",
    "unmatched_count = (\n",
    "    prices_markets[\"_merge\"] == \"left_only\"\n",
    ").sum()\n",
    "print(f\"Unmatched price records: {unmatched_count}\")\n",
    "\n",
    "# Remove the temporary merge-status column and order the final data\n",
    "prices_markets = prices_markets.drop(columns=[\"_merge\"])\n",
    "prices_markets = prices_markets.sort_values(\n",
    "    [\"market\", \"commodity\", \"date\"]\n",
    ").reset_index(drop=True)\n",
    "\n",
    "print(f\"Combined dataset shape: {prices_markets.shape}\")\n",
    "display(prices_markets.head())"
   ]
  },
