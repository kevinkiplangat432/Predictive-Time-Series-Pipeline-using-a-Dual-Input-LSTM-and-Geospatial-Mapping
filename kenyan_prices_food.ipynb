   "source": [
    "#check on this part i worked on it.\n",
    "# Clean text columns before grouping and joining\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\", category=FutureWarning)\n",
    "text_columns = prices.select_dtypes(include=\"object\").columns\n",
    "\n",
    "for column in text_columns:\n",
    "    prices[column] = (\n",
    "        prices[column]\n",
    "        .astype(\"string\")\n",
    "        .str.strip()\n",
    "        .str.replace(r\"\\s+\", \" \", regex=True)\n",
    "    )\n",
    "\n",
    "# Check missing values in the fields needed for analysis\n",
    "print(\"Missing values before removal:\")\n",
    "display(prices.isna().sum().sort_values(ascending=False))\n",
    "\n",
    "# Remove rows missing essential forecasting information\n",
    "prices = prices.dropna(\n",
    "    subset=[\"date\", \"market\", \"commodity\", \"price\"]\n",
    ")\n",
    "\n",
    "# Remove zero and negative prices\n",
    "invalid_price_count = (prices[\"price\"] <= 0).sum()\n",
    "prices = prices[prices[\"price\"] > 0].copy()\n",
    "\n",
    "# Remove duplicate observations at the market-commodity-date-price type grain\n",
    "duplicate_columns = [\n",
    "    \"date\",\n",
    "    \"market\",\n",
    "    \"commodity\",\n",
    "    \"pricetype\"\n",
    "]\n",
    "duplicate_count = prices.duplicated(subset=duplicate_columns).sum()\n",
    "prices = prices.drop_duplicates(subset=duplicate_columns)\n",
    "\n",
    "# Sort the data chronologically for time-series analysis\n",
    "prices = prices.sort_values(\n",
    "    [\"market\", \"commodity\", \"date\"]\n",
    ").reset_index(drop=True)\n",
    "\n",
    "print(f\"Invalid prices removed: {invalid_price_count}\")\n",
    "print(f\"Duplicate rows removed: {duplicate_count}\")\n",
    "print(f\"Cleaned dataset shape: {prices.shape}\")\n",
    "display(prices.head())"
   ]
  },
