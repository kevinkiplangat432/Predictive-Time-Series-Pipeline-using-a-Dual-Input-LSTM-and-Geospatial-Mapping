    "for lag in range(0, 7):\n",
    "    shifted_rainfall = combined[\"rainfall\"].shift(lag)\n",
    "    lag_results[lag] = shifted_rainfall.corr(combined[\"price\"])\n",
    "\n",
    "lag_series = pd.Series(lag_results)"
